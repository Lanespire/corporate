{
  "name": "lanespire-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare:corporate": "node scripts/prepare-corporate.mjs",
    "prepare:tech-icons": "node scripts/prepare-tech-icons.mjs",
    "predev": "npm run prepare:corporate && npm run prepare:tech-icons",
    "dev": "vite dev",
    "prebuild": "npm run prepare:corporate && npm run prepare:tech-icons",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && npx --yes husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No tests specified' && exit 0",
    "ci:local": "npm run format:check && npm run lint && npm run check && npm run test"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "gsap": "^3.15.0",
    "lucide-svelte": "^1.0.1",
    "svelte-eslint-parser": "^1.9.0",
    "three": "^0.186.1",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "cookie": "^0.7.0"
  }
}
